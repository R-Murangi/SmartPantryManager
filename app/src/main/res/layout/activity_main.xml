<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFF7FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Smart Pantry Manager" android:textColor="#B83273"
            android:textSize="27sp" android:textStyle="bold" android:paddingTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Use what you have. Waste less." android:textColor="#756C73"
            android:textSize="16sp" android:paddingBottom="22dp"/>
        <TextView android:id="@+id/countText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Your pantry"
            android:textColor="#29232A" android:textSize="20sp" android:textStyle="bold"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/pantryRecycler"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="100dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>
        <Button android:id="@+id/addButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="+ Add ingredient"
            android:textColor="#FFFFFF" android:background="@drawable/pink_button"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/suggestionsButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Suggested recipes"
            android:textColor="#FFFFFF" android:background="@drawable/pink_button"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/settingsButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Settings"
            android:textColor="#FFFFFF" android:background="@drawable/pink_button"
            android:layout_marginTop="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tip: tap an ingredient to edit or delete it."
            android:textColor="#756C73" android:paddingTop="14dp"/>
    </LinearLayout>
</ScrollView>
