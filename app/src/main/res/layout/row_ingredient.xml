<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="13dp" android:layout_marginBottom="8dp"
    android:background="@drawable/white_card">
    <TextView android:id="@+id/ingredientName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Ingredient name"
        android:textColor="#29232A" android:textSize="17sp" android:textStyle="bold"/>
    <TextView android:id="@+id/ingredientQuantity" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Quantity"
        android:textColor="#756C73" android:textSize="14sp"/>
</LinearLayout>
