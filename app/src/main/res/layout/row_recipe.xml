<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp" android:layout_marginBottom="8dp"
    android:background="@drawable/white_card">
    <TextView android:id="@+id/recipeName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Recipe name" android:textSize="17sp"
        android:textStyle="bold" android:textColor="#B83273"/>
    <TextView android:id="@+id/recipeIngredients" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Ingredients" android:textColor="#29232A"
        android:paddingTop="4dp"/>
</LinearLayout>
